# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff
# Рабочая группа, куда идут алерты и где работают команды
TELEGRAM_CHAT_ID=-1001234567890
# ID админов через запятую — им доступны все команды (silence, ack и т.д.).
# Пусто = все участники группы считаются админами.
TELEGRAM_ADMIN_IDS=11111111,22222222
# Кого упоминать в critical-алертах: @username через запятую
TELEGRAM_ADMIN_MENTIONS=@admin1,@admin2
# Дополнительные разрешённые чаты (кроме TELEGRAM_CHAT_ID)
TELEGRAM_ALLOWED_CHAT_IDS=
# Топики (threads) в группе-форуме: алерты и статистика (пусто — общий чат)
TELEGRAM_ALERTS_THREAD_ID=
TELEGRAM_STATS_THREAD_ID=

# Часовой пояс сообщений
TZ_NAME=Asia/Almaty

# --- Prometheus / Alertmanager ----------------------------------------------
PROMETHEUS_URL=http://host.docker.internal:9090
ALERTMANAGER_URL=http://host.docker.internal:9093
PROMETHEUS_TIMEOUT=10
PROMETHEUS_RATE_WINDOW=5m

# --- Приёмник Alertmanager-вебхуков -----------------------------------------
# monitoring/webhook.url -> http://tg-alert-bot:8080/alertmanager
WEBHOOK_ENABLED=true
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/alertmanager
# Секрет: Alertmanager шлёт его как Bearer-токен (см. deploy/alertmanager-example.yml)
WEBHOOK_SECRET=CHANGE_ME
# Один и тот же алерт (fingerprint+status) не шлётся чаще, чем раз в N секунд
ALERT_DEDUP_SECONDS=300
# Батчинг warning'ов при шторме, сек (0 — слать сразу; critical всегда сразу)
WARNING_BATCH_SECONDS=0

# --- GPU (DCGM exporter) -----------------------------------------------------
GPU_ENABLED=true
GPU_TEMP_WARN=80
GPU_TEMP_CRIT=88
EXPECTED_GPU_COUNT=2

# --- VLM / Ollama ------------------------------------------------------------
OLLAMA_ENABLED=true

# --- Docker-контейнеры prod-проекта -----------------------------------------
# Требует смонтированный /var/run/docker.sock (см. docker-compose.yml)
DOCKER_ENABLED=true
DOCKER_SOCKET=/var/run/docker.sock
COMPOSE_PROJECT_NAME=mlbahandi-prod
DOCKER_CRITICAL_CONTAINERS=ml-platform,analytics-worker,frame-ingest,redis,webapp-backend,webapp-db,go2rtc
DOCKER_CHECK_INTERVAL=30
# Контейнер не запущен дольше N секунд -> critical
DOCKER_DOWN_SECONDS=90
# N рестартов за окно -> restart-loop critical
DOCKER_RESTART_THRESHOLD=3
DOCKER_RESTART_WINDOW=600

# --- Дайджесты ---------------------------------------------------------------
DIGEST_ENABLED=true
# Локальное время (TZ_NAME) через запятую
DIGEST_TIMES=09:00,21:00

# --- Heartbeat (healthchecks.io и т.п.; пусто — выключено) -------------------
HEARTBEAT_URL=
HEARTBEAT_INTERVAL=60

# --- HTTP-сервисы (опционально) ---------------------------------------------
# Каждый сервис: name и url обязательны. Дополнительно:
#   method — HTTP-метод (по умолчанию GET)
#   body — тело запроса (JSON-объект уйдёт как application/json, строка — как есть)
#   headers — заголовки запроса (JSON-объект)
#   expect_status — ожидаемый статус или список статусов (по умолчанию 2xx и 468)
#   expect_contains — строка, которая должна быть в теле ответа
# SERVICES=[{"name":"webapp","url":"https://example.com/health"}]
SERVICES=
CHECK_INTERVAL=60

# --- RTSP-камеры (опционально, прямые проверки помимо ML-метрик) -------------
CAMERA_MONITOR_ENABLED=false
CAMERA_CHECK_TIMEOUT=10
# Вариант 1: статический список
# CAMERAS=[{"name":"Камера 1","url":"rtsp://user:pass@host:554/Streaming/Channels/101"}]
CAMERAS=
# Вариант 2: список с внешней ручки (перекрывает CAMERAS)
CAMERAS_URL=
CAMERAS_REFRESH_INTERVAL=300
CAMERAS_SOURCE_TIMEOUT=10
CAMERAS_API_TOKEN=
CAMERAS_HEADERS=
CAMERAS_NOTIFY_CHANGES=true

# --- Метрики хоста и встроенные пороги ---------------------------------------
METRICS_ENABLED=true
METRICS_CHECK_INTERVAL=60
# auto — сначала Prometheus, при отсутствии данных откат на psutil
METRICS_SOURCE=auto
DISK_MOUNTPOINT=/
NET_DEVICE_EXCLUDE=lo|veth.*|docker.*|br-.*|virbr.*|tun.*

# Пороги встроенных алертов (0 или off — правило выключено)
ALERT_CPU_PERCENT=85
ALERT_MEMORY_PERCENT=90
ALERT_DISK_PERCENT=90
ALERT_SWAP_PERCENT=off
ALERT_LOAD_PER_CORE=2
ALERT_TRIGGER_COUNT=3
ALERT_RECOVERY_COUNT=2
ALERT_REPEAT_MINUTES=30
